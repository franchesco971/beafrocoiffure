# Copier vers .env : cp .env.example .env  (ne jamais commiter .env)
POSTGRES_USER=beafro
POSTGRES_PASSWORD=beafro_dev
POSTGRES_DB=beafro

# Depuis le conteneur `app` : hôte `db`. Depuis votre machine : remplacer `db` par `localhost`.
DATABASE_URL=postgresql://beafro:beafro_dev@db:5432/beafro

# Mailpit (capture des e-mails en local) : interface sur http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025

# Sessions Auth.js : générer une valeur avec `openssl rand -base64 32`
AUTH_SECRET=
# Derrière un reverse proxy en production (Caddy), ajouter : AUTH_TRUST_HOST=true

# Compte administrateur créé par `prisma db seed` (mot de passe de 12 caractères minimum)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dossier des fichiers téléversés (galerie), relatif au dossier du projet ; défaut : uploads
# UPLOAD_DIR=uploads
