# Copier vers .env : cp .env.example .env  (ne jamais commiter .env)
MYSQL_ROOT_PASSWORD=beafro_root_dev
MYSQL_DATABASE=beafro
MYSQL_USER=beafro
MYSQL_PASSWORD=beafro_dev

# Depuis le conteneur `app` : hôte `db`, port 3306. Depuis votre machine : `localhost`, port 3307.
# Mot de passe avec des caractères spéciaux (+ @ : / ...) : l'encoder en URL (encodeURIComponent).
DATABASE_URL=mysql://beafro:beafro_dev@db:3306/beafro

# Mailpit (capture des e-mails en local) : interface sur http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025

# Sessions Auth.js : générer une valeur avec `openssl rand -base64 32`
AUTH_SECRET=
# Derrière un reverse proxy en production (Caddy), ajouter : AUTH_TRUST_HOST=true

# Compte administrateur créé par `prisma db seed` (mot de passe de 12 caractères minimum)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dossier des fichiers téléversés (galerie), relatif au dossier du projet ; défaut : uploads
# UPLOAD_DIR=uploads

# URL publique du site (SEO : sitemap, balises canoniques, données structurées) ; défaut : https://www.beafrocoiffure.fr
# SITE_URL=https://www.beafrocoiffure.fr

# Anti-spam Cloudflare Turnstile (facultatif : sans ces deux clés, seuls le champ piège et la limitation de débit agissent).
# Clés de test Cloudflare : site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
