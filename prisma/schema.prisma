generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── Énumérations ─────────

enum AdminRole {
  ADMIN
  STAFF

  @@map("admin_role")
}

enum Universe {
  HAIR
  WELLNESS

  @@map("universe")
}

enum PriceMode {
  FIXED
  QUOTE

  @@map("price_mode")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("booking_status")
}

enum BookingSource {
  ONLINE
  ADMIN

  @@map("booking_source")
}

enum LocationType {
  SALON
  HOME
  MOBILE

  @@map("location_type")
}

enum TimeOffType {
  HOLIDAY
  BLOCK

  @@map("time_off_type")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum EventRegistrationStatus {
  CONFIRMED
  CANCELLED

  @@map("event_registration_status")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

enum NotificationType {
  BOOKING_REQUESTED
  BOOKING_CONFIRMED
  BOOKING_CHANGED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  ADMIN_BOOKING_NEW
  ADMIN_BOOKING_CANCELLED
  EVENT_REGISTRATION
  ADMIN_EVENT_REGISTRATION

  @@map("notification_type")
}

enum NotificationChannel {
  EMAIL
  SMS

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED

  @@map("notification_status")
}

// ───────── Administration et comptes ─────────

model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  auditLogs AuditLog[]

  @@map("admin_user")
}

// Vide en phase 1 : prête pour les comptes clients (phase 2).
model UserAccount {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clients Client[]

  @@map("user_account")
}

model AuditLog {
  id        Int        @id @default(autoincrement())
  adminId   Int?       @map("admin_id")
  action    String
  entity    String
  entityId  String?    @map("entity_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ───────── Clients ─────────

// Réservation sans compte : `userAccountId` reste nul jusqu'au rattachement (phase 2).
model Client {
  id            Int       @id @default(autoincrement())
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String
  email         String?   @unique
  userAccountId Int?      @map("user_account_id")
  consentAt     DateTime? @map("consent_at") @db.Timestamptz(3)
  anonymizedAt  DateTime? @map("anonymized_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  userAccount UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  bookings    Booking[]

  @@index([userAccountId])
  @@index([lastName, firstName])
  @@map("client")
}

// ───────── Catalogue ─────────

model ServiceCategory {
  id       Int      @id @default(autoincrement())
  name     String
  slug     String   @unique
  universe Universe
  position Int      @default(0)

  services Service[]

  @@map("service_category")
}

model Service {
  id                 Int       @id @default(autoincrement())
  categoryId         Int       @map("category_id")
  slug               String    @unique
  title              String
  description        String    @default("")
  videoUrl           String?   @map("video_url")
  priceMode          PriceMode @default(QUOTE) @map("price_mode")
  priceCents         Int?      @map("price_cents")
  durationMin        Int       @map("duration_min")
  conditions         String?
  requiresValidation Boolean   @default(false) @map("requires_validation")
  depositCents       Int?      @map("deposit_cents")
  isActive           Boolean   @default(true) @map("is_active")
  position           Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookingItems BookingItem[]
  media        Media[]

  @@index([categoryId, position])
  @@map("service")
}

// ───────── Réservations ─────────

model Booking {
  id           Int           @id @default(autoincrement())
  clientId     Int           @map("client_id")
  status       BookingStatus @default(PENDING)
  startsAt     DateTime      @map("starts_at") @db.Timestamptz(3)
  // Bloc occupé : durée totale + pause entre prestations (cf. document technique §6.1).
  endsAt       DateTime      @map("ends_at") @db.Timestamptz(3)
  locationType LocationType? @map("location_type")
  address      String?
  notes        String?
  // Jeton aléatoire (≥ 128 bits) du lien client d'annulation/modification.
  cancelToken  String        @unique @default(dbgenerated("replace(((gen_random_uuid())::text || (gen_random_uuid())::text), '-'::text, ''::text)")) @map("cancel_token")
  source       BookingSource @default(ONLINE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items         BookingItem[]
  payments      Payment[]
  notifications Notification[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([clientId])
  @@map("booking")
}

// Copie de la durée et du tarif au moment de la réservation.
model BookingItem {
  id          Int  @id @default(autoincrement())
  bookingId   Int  @map("booking_id")
  serviceId   Int  @map("service_id")
  durationMin Int  @map("duration_min")
  priceCents  Int? @map("price_cents")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([bookingId, serviceId])
  @@index([serviceId])
  @@map("booking_item")
}

// Plages hebdomadaires ; weekday : 1 = lundi … 7 = dimanche (ISO).
model WorkingHours {
  id        Int      @id @default(autoincrement())
  weekday   Int
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  @@index([weekday])
  @@map("working_hours")
}

model TimeOff {
  id       Int         @id @default(autoincrement())
  startsAt DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime    @map("ends_at") @db.Timestamptz(3)
  reason   String?
  type     TimeOffType @default(BLOCK)

  @@index([startsAt, endsAt])
  @@map("time_off")
}

// Règles paramétrables (ex. `booking.buffer_minutes`) : cf. document technique §6.5.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("setting")
}

model Payment {
  id          Int           @id @default(autoincrement())
  bookingId   Int           @map("booking_id")
  provider    String
  providerRef String?       @unique @map("provider_ref")
  amountCents Int           @map("amount_cents")
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("payment")
}

// File d'envoi traitée par le worker (reprise automatique en cas d'échec).
model Notification {
  id                  Int                 @id @default(autoincrement())
  bookingId           Int?                @map("booking_id")
  eventRegistrationId Int?                @map("event_registration_id")
  type                NotificationType
  channel             NotificationChannel @default(EMAIL)
  recipient           String
  scheduledAt         DateTime            @map("scheduled_at") @db.Timestamptz(3)
  sentAt              DateTime?           @map("sent_at") @db.Timestamptz(3)
  status              NotificationStatus  @default(PENDING)
  attempts            Int                 @default(0)
  lastError           String?             @map("last_error")

  booking           Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  eventRegistration EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([bookingId])
  @@index([eventRegistrationId])
  @@map("notification")
}

// ───────── Événements ─────────

model Event {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String   @default("")
  startsAt    DateTime @map("starts_at") @db.Timestamptz(3)
  location    String?
  priceCents  Int?     @map("price_cents")
  // Nul = places illimitées.
  capacity    Int?
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrations EventRegistration[]

  @@index([startsAt])
  @@map("event")
}

model EventRegistration {
  id        Int                     @id @default(autoincrement())
  eventId   Int                     @map("event_id")
  name      String
  email     String
  phone     String?
  status    EventRegistrationStatus @default(CONFIRMED)
  consentAt DateTime                @map("consent_at") @db.Timestamptz(3)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([eventId, status])
  @@map("event_registration")
}

// ───────── Galerie, avis, contact, contenus ─────────

model GalleryCategory {
  id       Int    @id @default(autoincrement())
  name     String
  slug     String @unique
  position Int    @default(0)

  media Media[]

  @@map("gallery_category")
}

model Media {
  id                Int       @id @default(autoincrement())
  type              MediaType
  url               String
  alt               String?
  galleryCategoryId Int?      @map("gallery_category_id")
  serviceId         Int?      @map("service_id")
  isBeforeAfter     Boolean   @default(false) @map("is_before_after")
  position          Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  galleryCategory GalleryCategory? @relation(fields: [galleryCategoryId], references: [id], onDelete: SetNull)
  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([galleryCategoryId, position])
  @@index([serviceId])
  @@map("media")
}

model Review {
  id        Int          @id @default(autoincrement())
  author    String
  rating    Int
  text      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status])
  @@map("review")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  consentAt DateTime @map("consent_at") @db.Timestamptz(3)
  handled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([handled, createdAt])
  @@map("contact_message")
}

// Textes modifiables depuis l'administration ; `locale` prévu pour une éventuelle traduction.
model PageContent {
  key       String
  locale    String   @default("fr")
  content   Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([key, locale])
  @@map("page_content")
}
